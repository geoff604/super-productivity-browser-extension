{
  "manifest_version": 3,
  "name": "Page Clipper for Super Productivity",
  "version": "1.0.0",
  "description": "Unofficial. Clip the current page into the Super Productivity desktop app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:3876/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Add page to Super Productivity",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open the page clipper"
    }
  }
}